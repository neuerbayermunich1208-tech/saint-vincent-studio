# Saint Vincent Studio — environment variables (names only, never commit real values)
# Copy to .env.local for development.

# App
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_DEFAULT_LOCALE=en

# Database (PostgreSQL)
DATABASE_URL=

# Payload CMS
PAYLOAD_SECRET=
PAYLOAD_PREVIEW_SECRET=

# Object storage (S3-compatible: Supabase Storage / Cloudflare R2)
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
NEXT_PUBLIC_MEDIA_BASE_URL=

# Email (transactional + newsletter)
EMAIL_FROM=
RESEND_API_KEY=

# Payments (Phase 4, sandbox first — provider to be decided)
PAYMENT_PROVIDER=
PAYMENT_CLIENT_ID=
PAYMENT_API_KEY=
PAYMENT_CHECKSUM_KEY=
PAYMENT_WEBHOOK_SECRET=

# Rate limiting (optional, e.g. Upstash Redis)
RATE_LIMIT_REDIS_URL=
RATE_LIMIT_REDIS_TOKEN=

# Anti-spam for public forms (optional, e.g. Cloudflare Turnstile)
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
